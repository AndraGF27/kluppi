# Optional. Used by @vercel/kv after you connect Vercel KV / Redis Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# theMarketer — server-side Add Subscriber API (/api/add-subscriber).
# REST_KEY is a SECRET (server-only, never expose to the browser). Both are in
# theMarketer → Settings → Technical Integration. Set these in Vercel too.
THEMARKETER_REST_KEY=
THEMARKETER_CUSTOMER_ID=
